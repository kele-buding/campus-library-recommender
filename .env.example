# Spring 运行配置：h2（本地免安装快速开发）或 postgres（目标 PostgreSQL 与并发验收）
SPRING_PROFILES_ACTIVE=h2
SERVER_PORT=8080

# PostgreSQL 连接配置（仅当 SPRING_PROFILES_ACTIVE=postgres 时生效）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=campus_library
DB_USER=campus_library
DB_PASSWORD=campus_library_dev

# 实验环境开关（仅实验/演示环境开启，生产环境设为 false）
ENABLE_EXPERIMENTAL_CLOCK=true

# 初始化数据脚本（DU-10）默认测试账号密码（仅用于演示与本地开发）
SEED_DEFAULT_PASSWORD=CampusLib#2026

# 华为云配置（严格通过环境变量注入，严禁入库）
HUAWEI_CLOUD_MOCK=true
HUAWEI_CLOUD_REGION=cn-north-4
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_FG_PROJECT_ID=
HUAWEI_FG_PURCHASE_URN=
HUAWEI_FG_REMIND_URN=
HUAWEI_OBS_ENDPOINT=
HUAWEI_OBS_BUCKET=
CLOUD_CALLBACK_TOKEN=dev-callback-token-change-me
CLOUD_MONTHLY_BUDGET_LIMIT=5000
